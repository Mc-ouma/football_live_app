import 'package:freezed_annotation/freezed_annotation.dart';
import 'shared_models.dart' as shared;

part 'prediction_model.freezed.dart';
part 'prediction_model.g.dart';

class PredictionResponse {
  final String get;
  final Map<String, dynamic> parameters;
  final List<dynamic> errors;
  final int results;
  final Map<String, dynamic> paging;
  final List<PredictionData> response;

  const PredictionResponse({
    required this.get,
    required this.parameters,
    required this.errors,
    required this.results,
    required this.paging,
    required this.response,
  });

  factory PredictionResponse.fromJson(Map<String, dynamic> json) {
    try {
      final String getString = json['get'] as String? ?? '';
      final Map<String, dynamic> parametersValue = json['parameters'] as Map<String, dynamic>? ?? {};
      final List<dynamic> errorsList = json['errors'] as List<dynamic>? ?? [];
      final int resultsValue = json['results'] as int? ?? 0;
      final Map<String, dynamic> pagingValue = json['paging'] as Map<String, dynamic>? ?? {};
      
      final responseList = json['response'] as List<dynamic>? ?? [];
      final List<PredictionData> typedResponseList = responseList
          .map((dynamic item) => item is Map<String, dynamic> 
              ? PredictionData.safeFromJson(item) 
              : PredictionData.safeFromJson({}))
          .toList();
          
      return PredictionResponse(
        get: getString,
        parameters: parametersValue,
        errors: errorsList,
        results: resultsValue,
        paging: pagingValue,
        response: typedResponseList,
      );
    } catch (e) {
      print('Error parsing PredictionResponse: $e');
      // Return a default response with empty data
      return const PredictionResponse(
        get: '',
        parameters: <String, dynamic>{},
        errors: <dynamic>[],
        results: 0,
        paging: <String, dynamic>{},
        response: <PredictionData>[],
      );
    }
  }
  
  Map<String, dynamic> toJson() => {
    'get': get,
    'parameters': parameters,
    'errors': errors,
    'results': results,
    'paging': paging,
    'response': response.map((data) => data.toJson()).toList(),
  };
}

class PredictionData {
  final Predictions predictions;
  final shared.League league;
  final shared.Teams teams;
  final shared.Fixture fixture;
  final Comparison? comparison;
  final List<H2H>? h2h;

  const PredictionData({
    required this.predictions,
    required this.league,
    required this.teams,
    required this.fixture,
    this.comparison,
    this.h2h,
  });

  // Regular fromJson method
  factory PredictionData.fromJson(Map<String, dynamic> json) {
    try {
      return PredictionData(
        predictions: Predictions.fromJson(json['predictions'] ?? {}),
        league: shared.League.fromJson(json['league'] ?? {}),
        teams: shared.Teams.fromJson(json['teams'] ?? {}),
        fixture: shared.Fixture.fromJson(json['fixture'] ?? {}),
        comparison: json['comparison'] != null ? Comparison.fromJson(json['comparison']) : null,
        h2h: json['h2h'] != null && json['h2h'] is List
            ? (json['h2h'] as List)
                .where((e) => e is Map<String, dynamic>)
                .map((e) => H2H.fromJson(e as Map<String, dynamic>))
                .toList()
            : null,
      );
    } catch (e) {
      print('Error in PredictionData.fromJson: $e');
      throw e; // Re-throw to be caught by safeFromJson
    }
  }
  
  // toJson method for serialization
  Map<String, dynamic> toJson() => {
    'predictions': predictions.toJson(),
    'league': league.toJson(),
    'teams': teams.toJson(), 
    'fixture': fixture.toJson(),
    'comparison': comparison?.toJson(),
    'h2h': h2h?.map((item) => item.toJson()).toList(),
  };

  // Provide a static method to create from a JSON map with fallbacks
  static PredictionData safeFromJson(Map<String, dynamic> json) {
    try {
      // Create a safe copy of the JSON to work with
      final processedJson = Map<String, dynamic>.from(json);
      
      // Handle predictions
      if (processedJson['predictions'] == null) {
        processedJson['predictions'] = {
          'winner': {'id': null, 'name': null, 'comment': null},
          'win_or_draw': false,
          'under_over': null,
          'goals': {'home': null, 'away': null},
          'advice': 'No predictions available',
          'percent': {'home': '33%', 'draw': '33%', 'away': '33%'}
        };
      } else if (processedJson['predictions'] is! Map<String, dynamic>) {
        processedJson['predictions'] = {
          'winner': {'id': null, 'name': null, 'comment': null},
          'win_or_draw': false,
          'under_over': null,
          'goals': {'home': null, 'away': null},
          'advice': 'No predictions available',
          'percent': {'home': '33%', 'draw': '33%', 'away': '33%'}
        };
      } else {
        // Ensure all required nested objects exist in predictions
        final predictions = processedJson['predictions'] as Map<String, dynamic>;
        
        // Handle winner object
        if (predictions['winner'] == null || predictions['winner'] is! Map<String, dynamic>) {
          predictions['winner'] = {'id': null, 'name': null, 'comment': null};
        }
        
        // Handle goals object
        if (predictions['goals'] == null || predictions['goals'] is! Map<String, dynamic>) {
          predictions['goals'] = {'home': null, 'away': null};
        }
        
        // Handle percent object
        if (predictions['percent'] == null || predictions['percent'] is! Map<String, dynamic>) {
          predictions['percent'] = {'home': '33%', 'draw': '33%', 'away': '33%'};
        }
        
        // Ensure advice has a default value if missing
        if (predictions['advice'] == null) {
          predictions['advice'] = 'No predictions available';
        }
      }
      
      // Handle league
      if (processedJson['league'] == null || processedJson['league'] is! Map<String, dynamic>) {
        processedJson['league'] = {
          'id': 0,
          'name': 'Unknown',
          'country': 'Unknown',
          'logo': '',
          'season': 0
        };
      }
      
      // Handle fixture
      if (processedJson['fixture'] == null || processedJson['fixture'] is! Map<String, dynamic>) {
        processedJson['fixture'] = {
          'id': 0,
          'timezone': 'UTC',
          'date': DateTime.now().toIso8601String(),
          'timestamp': DateTime.now().millisecondsSinceEpoch ~/ 1000,
          'venue': {'name': 'Unknown', 'city': 'Unknown'},
          'status': {'long': 'Not Started', 'short': 'NS'}
        };
      }
      
      // Handle teams
      if (processedJson['teams'] == null || processedJson['teams'] is! Map<String, dynamic>) {
        processedJson['teams'] = {
          'home': {'id': 0, 'name': 'Home Team', 'logo': ''},
          'away': {'id': 0, 'name': 'Away Team', 'logo': ''}
        };
      }
      
      // Instead of using the generated fromJson method which might be causing issues,
      // manually create the PredictionData object
      return PredictionData(
        predictions: Predictions.fromJson(processedJson['predictions'] as Map<String, dynamic>),
        league: shared.League.fromJson(processedJson['league'] as Map<String, dynamic>),
        teams: shared.Teams.fromJson(processedJson['teams'] as Map<String, dynamic>),
        fixture: shared.Fixture.fromJson(processedJson['fixture'] as Map<String, dynamic>),
        comparison: processedJson['comparison'] != null 
            ? Comparison.fromJson(processedJson['comparison'] as Map<String, dynamic>)
            : null,
        h2h: processedJson['h2h'] != null && processedJson['h2h'] is List
            ? (processedJson['h2h'] as List)
                .where((e) => e is Map<String, dynamic>)
                .map((e) => H2H.fromJson(e as Map<String, dynamic>))
                .toList()
            : null,
      );
    } catch (e) {
      print('Error in PredictionData.fromJson: $e');
      // Instead of throwing, provide a default instance
      return PredictionData(
        predictions: Predictions(
          winner: Winner(id: null, name: null, comment: null),
          winOrDraw: false,
          underOver: null,
          goals: PredictionGoals(home: null, away: null),
          advice: 'No predictions available',
          percent: Percent(home: '33%', draw: '33%', away: '33%'),
        ),
        league: shared.League(
          id: 0,
          name: 'Unknown League',
          country: 'Unknown',
          logo: '',
          season: 0,
        ),
        teams: shared.Teams(
          home: shared.Team(id: 0, name: 'Home Team', logo: ''),
          away: shared.Team(id: 0, name: 'Away Team', logo: ''),
        ),
        fixture: shared.Fixture(
          id: 0,
          timezone: 'UTC',
          date: DateTime.now().toString(),
          timestamp: DateTime.now().millisecondsSinceEpoch ~/ 1000,
          venue: shared.Venue(name: 'Unknown', city: 'Unknown'),
          status: shared.Status(long: 'Not Started', short: 'NS'),
        ),
      );
    }
  }
}

// Renamed Goals class to PredictionGoals to avoid conflicts
// Renamed from Goals to PredictionGoals to avoid conflicts
class PredictionGoals {
  final int? home;
  final int? away;
  
  const PredictionGoals({
    this.home,
    this.away,
  });

  factory PredictionGoals.fromJson(Map<String, dynamic> json) {
    try {
      return PredictionGoals(
        home: json['home'] is int ? json['home'] : null,
        away: json['away'] is int ? json['away'] : null,
      );
    } catch (e) {
      print('Error in PredictionGoals.fromJson: $e');
      return const PredictionGoals(home: null, away: null);
    }
  }
  
  // Manual toJson to ensure correct serialization
  Map<String, dynamic> toJson() => {
    'home': home,
    'away': away,
  };
}

