  final int? id;
  final String? name;
  final String? comment;

  const Winner({
    this.id,
    this.name,
    this.comment,
  });

  factory Winner.fromJson(Map<String, dynamic> json) {
    try {
      return Winner(
        id: json['id'] is int ? json['id'] : null,
        name: json['name'] as String?,
        comment: json['comment'] as String?,
      );
    } catch (e) {
      print('Error in Winner.fromJson: $e');
      return const Winner(id: null, name: null, comment: null);
