    'comment': comment,
  };
}

class Percent {
  final String home;
  final String draw;
  final String away;

  const Percent({
    required this.home,
    required this.draw,
    required this.away,
  });

  factory Percent.fromJson(Map<String, dynamic> json) {
    try {
      // Process 'home' field
      final String homeValue = json['home'] is String
          ? json['home']
          : json['home']?.toString() ?? '33%';

      // Process 'draw' field
      final String drawValue = json['draw'] is String
          ? json['draw']
          : json['draw']?.toString() ?? '33%';

      // Process 'away' field
      final String awayValue = json['away'] is String
          ? json['away']
          : json['away']?.toString() ?? '33%';

      return Percent(
        home: homeValue,
        draw: drawValue,
        away: awayValue,
      );
    } catch (e) {
      print('Error in Percent.fromJson: $e');
      return const Percent(home: '33%', draw: '33%', away: '33%');
    }
  }

  // Manual toJson to ensure correct serialization
  Map<String, dynamic> toJson() => {
    'home': home,
    'draw': draw,
    'away': away,
  };
}
}

class Predictions {
  final Winner? winner;
  final bool? winOrDraw;
  final dynamic underOver;
  final PredictionGoals? goals;
  final String advice;
  final Percent? percent;

  const Predictions({
    this.winner,
    this.winOrDraw,
    this.underOver,
    this.goals,
    required this.advice,
    this.percent,
  });

  factory Predictions.fromJson(Map<String, dynamic> json) {
    try {
      // Create a new map so we can modify it safely
      final processedJson = Map<String, dynamic>.from(json);

      // Handle advice - ensure it's a String
      final String adviceString = processedJson['advice'] is String 
          ? processedJson['advice'] 
          : processedJson['advice']?.toString() ?? 'No advice available';

      // Process and convert nested objects
      final Winner? winnerObj = processedJson['winner'] != null && processedJson['winner'] is Map<String, dynamic>
          ? Winner.fromJson(processedJson['winner'])
          : null;
          
      final PredictionGoals? goalsObj = processedJson['goals'] != null && processedJson['goals'] is Map<String, dynamic>
          ? PredictionGoals.fromJson(processedJson['goals'])
          : null;
          
      final Percent? percentObj = processedJson['percent'] != null && processedJson['percent'] is Map<String, dynamic>
          ? Percent.fromJson(processedJson['percent'])
          : null;

      return Predictions(
        winner: winnerObj,
        winOrDraw: processedJson['win_or_draw'] is bool ? processedJson['win_or_draw'] : false,
        underOver: processedJson['under_over'],
        goals: goalsObj,
        advice: adviceString,
        percent: percentObj,
      );
    } catch (e) {
      print('Error in Predictions.fromJson: $e');
      // Provide default values for required fields
      return Predictions(
        winner: Winner(id: null, name: null, comment: null),
        winOrDraw: false,
        underOver: null,
        goals: PredictionGoals(home: null, away: null),
        advice: 'No predictions available',
        percent: Percent(home: '33%', draw: '33%', away: '33%'),
      );
    }
  }

  // Manual toJson to ensure correct serialization
  Map<String, dynamic> toJson() => {
    'winner': winner?.toJson(),
    'win_or_draw': winOrDraw,
    'under_over': underOver,
    'goals': goals?.toJson(),
    'advice': advice,
    'percent': percent?.toJson(),
  };
}

class Comparison {
  final Map<String, String> form;
  final Map<String, String> att;
  final Map<String, String> def;
  final Map<String, String> poissonDistribution;
  final Map<String, String> headToHead;
  final Map<String, String> goals;
  final Map<String, String> total;

  const Comparison({
    required this.form,
    required this.att,
    required this.def,
    required this.poissonDistribution,
    required this.headToHead,
    required this.goals,
    required this.total,
  });

  factory Comparison.fromJson(Map<String, dynamic> json) {
    try {
      // Safely convert maps of any type to Map<String, String>
      Map<String, String> safeStringMap(dynamic value) {
        if (value == null) return {};
        if (value is! Map) return {};
        
        final result = <String, String>{};
        value.forEach((key, val) {
          if (key is String) {
            result[key] = val?.toString() ?? '';
          }
        });
        return result;
      }

      return Comparison(
        form: safeStringMap(json['form']),
        att: safeStringMap(json['att']),
        def: safeStringMap(json['def']),
        poissonDistribution: safeStringMap(json['poisson_distribution']),
        headToHead: safeStringMap(json['h2h']),
        goals: safeStringMap(json['goals']),
        total: safeStringMap(json['total']),
      );
    } catch (e) {
      print('Error in Comparison.fromJson: $e');
      return const Comparison(
        form: {},
        att: {},
        def: {},
        poissonDistribution: {},
        headToHead: {},
        goals: {},
        total: {},
      );
    }
  }
  
  Map<String, dynamic> toJson() => {
    'form': form,
    'att': att,
    'def': def,
    'poisson_distribution': poissonDistribution,
    'h2h': headToHead,
    'goals': goals,
    'total': total,
  };
        att: safeStringMap(json['att']),
        def: safeStringMap(json['def']),
        poissonDistribution: safeStringMap(json['poisson_distribution']),
        headToHead: safeStringMap(json['h2h']),
        goals: safeStringMap(json['goals']),
        total: safeStringMap(json['total']),
      );
    } catch (e) {
      print('Error in Comparison.fromJson: $e');
      return Comparison(
        form: {},
        att: {},
        def: {},
        poissonDistribution: {},
        headToHead: {},
        goals: {},
        total: {},
      );
    }
  }
}

// Use the renamed PredictionGoals instead of Goals
class H2H {
  final shared.Fixture fixture;
  final shared.League league;
  final shared.Teams teams;
  final PredictionGoals goals;
  final Score score;

  const H2H({
    required this.fixture,
    required this.league,
    required this.teams,
    required this.goals,
    required this.score,
  });

  factory H2H.fromJson(Map<String, dynamic> json) {
    try {
      return H2H(
        fixture: shared.Fixture.fromJson(json['fixture'] ?? {}),
        league: shared.League.fromJson(json['league'] ?? {}),
        teams: shared.Teams.fromJson(json['teams'] ?? {}),
        goals: PredictionGoals.fromJson(json['goals'] ?? {}),
        score: Score.fromJson(json['score'] ?? {}),
      );
    } catch (e) {
      print('Error in H2H.fromJson: $e');
      // Return a default instance instead of throwing
      return H2H(
        fixture: shared.Fixture(
          id: 0,
          timezone: 'UTC',
          date: '',
          timestamp: 0,
          venue: shared.FixtureVenue(name: ''),  // Using FixtureVenue instead of Venue
          status: shared.FixtureStatus(long: '', short: ''),  // Using FixtureStatus instead of Status
        ),
        league: shared.League(
          id: 0,
          name: '',
          country: '',
          logo: '',
          season: 0,
        ),
        teams: shared.Teams(
          home: shared.Team(id: 0, name: '', logo: ''),
          away: shared.Team(id: 0, name: '', logo: ''),
        ),
        goals: PredictionGoals(home: null, away: null),
        score: Score(
          halftime: ScoreDetails(home: null, away: null),
          fulltime: ScoreDetails(home: null, away: null),
        ),
      );
    }
  }
  
  Map<String, dynamic> toJson() => {
    'fixture': fixture,
    'league': league,
    'teams': teams,
    'goals': goals.toJson(),
    'score': score,
  };
}

class Score {
  final ScoreDetails halftime;
  final ScoreDetails fulltime;
  final ScoreDetails? extratime;
  final ScoreDetails? penalty;

  const Score({
    required this.halftime,
    required this.fulltime,
    this.extratime,
    this.penalty,
  });

  factory Score.fromJson(Map<String, dynamic> json) {
    try {
      return Score(
        halftime: ScoreDetails.fromJson(json['halftime'] ?? {}),
        fulltime: ScoreDetails.fromJson(json['fulltime'] ?? {}),
        extratime: json['extratime'] != null ? ScoreDetails.fromJson(json['extratime']) : null,
        penalty: json['penalty'] != null ? ScoreDetails.fromJson(json['penalty']) : null,
      );
    } catch (e) {
      print('Error in Score.fromJson: $e');
      return Score(
        halftime: ScoreDetails(home: null, away: null),
        fulltime: ScoreDetails(home: null, away: null),
      );
    }
  }
  
  Map<String, dynamic> toJson() => {
    'halftime': halftime.toJson(),
    'fulltime': fulltime.toJson(),
    'extratime': extratime?.toJson(),
    'penalty': penalty?.toJson(),
  };
}

class ScoreDetails {
  final int? home;
  final int? away;

  const ScoreDetails({
    this.home,
    this.away,
  });

  factory ScoreDetails.fromJson(Map<String, dynamic> json) {
    try {
      return ScoreDetails(
        home: json['home'] is int ? json['home'] : null,
        away: json['away'] is int ? json['away'] : null,
      );
    } catch (e) {
      print('Error in ScoreDetails.fromJson: $e');
      return ScoreDetails(home: null, away: null);
    }
  }
  
  Map<String, dynamic> toJson() => {
    'home': home,
    'away': away,
  };
}